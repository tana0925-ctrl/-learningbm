{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learningbm",
  "compatibility_date": "2026-02-23",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "ai": {
    "binding": "AI"
  },

  // GEMINI_API_KEY と GEMINI_API_KEY_2 は GitHub Actions の secrets から
  // デプロイ時に wrangler pages secret put で注入される（.github/workflows/deploy.yml）

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learningbm-production",
      "database_id": "8aa1f65c-47b0-4a6b-a040-e044fe00e17e"
    }
  ]
}
